{
  // Assets-only Worker: no `main` entry point, no build step.
  // Cloudflare serves everything in ./public as static files.
  "name": "josephklane",
  "compatibility_date": "2026-07-16",
  "assets": {
    "directory": "./public"
  },
  // Attaches the apex domain to this Worker. Requires josephklane.com to be
  // in the same Cloudflare account, which it is — DNS is handled automatically.
  "routes": [
    {
      "pattern": "josephklane.com",
      "custom_domain": true
    }
  ]
}
